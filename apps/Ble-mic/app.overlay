#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

&pinctrl {
	pwm0_default_custom: pwm0_default_custom {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 26)>,
				<NRF_PSEL(PWM_OUT1, 0, 30)>,
				<NRF_PSEL(PWM_OUT2, 0, 6)>;
			nordic,invert;
		};
	};

	pwm0_sleep_custom: pwm0_sleep_custom {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 26)>,
				<NRF_PSEL(PWM_OUT1, 0, 30)>,
				<NRF_PSEL(PWM_OUT2, 0, 6)>;
			low-power-enable;
		};
	};
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default_custom>;
	pinctrl-1 = <&pwm0_sleep_custom>;
	pinctrl-names = "default", "sleep";
};

/ {
	pwmleds {
		compatible = "pwm-leds";
		pwm_red: pwm_red {
			pwms = <&pwm0 0 PWM_MSEC(20) PWM_POLARITY_INVERTED>;
		};
		pwm_green: pwm_green {
			pwms = <&pwm0 1 PWM_MSEC(20) PWM_POLARITY_INVERTED>;
		};
		pwm_blue: pwm_blue {
			pwms = <&pwm0 2 PWM_MSEC(20) PWM_POLARITY_INVERTED>;
		};
	};

	aliases {
		pwm-red = &pwm_red;
		pwm-green = &pwm_green;
		pwm-blue = &pwm_blue;
	};
};

&pdm0 {
	status = "okay";
};

